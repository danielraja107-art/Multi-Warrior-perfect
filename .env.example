# Storm Arena — Server environment
# Copy to .env at the workspace root (or provide via your platform).

# HTTP/WebSocket port (shared by Express REST + Colyseus)
PORT=2567

# development | production
NODE_ENV=development

# PostgreSQL connection string (Prisma)
DATABASE_URL="postgresql://stormarena:stormarena@localhost:5433/stormarena?schema=public"

# JWT signing secret — MUST be changed and long in production
JWT_SECRET=replace-me-with-a-long-random-string
# JWT_EXPIRES_IN=7d

# Comma-separated list of allowed browser origins (or * for any)
CORS_ORIGIN=*